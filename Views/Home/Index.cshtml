@model IEnumerable<SimpleBlog.Models.Entities.BlogPost>
@using SimpleBlog.Models.Entities

@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron bg-light py-5 mb-5">
    <div class="container">
        <h1 class="display-4">Welcome to SimpleBlog</h1>
        <p class="lead">Discover articles about technology, business, and lifestyle.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <h2 class="mb-4">Latest Posts</h2>
        @if (Model != null)
        {
            @foreach (var post in Model)
            {
                <div class="card mb-4">
                    @if (!string.IsNullOrEmpty(post.FeaturedImage))
                    {
                        <img src="@post.FeaturedImage" class="card-img-top" alt="@post.Title" style="height: 250px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text">@post.ShortDescription</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                @if (post.Category != null)
                                {
                                    <span class="badge bg-info">@post.Category.Name</span>
                                }
                                <span> • @post.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </small>
                            <a href="@Url.Action("Post", "Blog", new { slug = post.Slug })" class="btn btn-sm btn-primary">Read More</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="alert alert-info">No posts available yet.</p>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Categories</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.Categories != null && ((IEnumerable<Category>)ViewBag.Categories).Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var category in (IEnumerable<Category>)ViewBag.Categories)
                        {
                            <li class="list-group-item">
                                <a href="@Url.Action("Category", "Blog", new { slug = category.Slug })" class="text-decoration-none">
                                    @category.Name
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No categories available.</p>
                }
            </div>
        </div>
    </div>
</div>
