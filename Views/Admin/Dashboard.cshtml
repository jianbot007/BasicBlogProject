@{
    ViewData["Title"] = "Admin Dashboard";
    dynamic stats = ViewBag.Stats;
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>Admin Dashboard</h1>
            <a href="@Url.Action("Logout", "Admin")" class="btn btn-danger">Logout</a>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Posts</h5>
                <p class="card-text display-4">@stats.TotalPosts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Published Posts</h5>
                <p class="card-text display-4">@stats.PublishedPosts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Draft Posts</h5>
                <p class="card-text display-4">@stats.DraftPosts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Total Categories</h5>
                <p class="card-text display-4">@stats.TotalCategories</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2 class="mb-4">Quick Actions</h2>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Posts</h5>
                <p class="card-text">Manage all blog posts - create, edit, and delete posts.</p>
                <a href="@Url.Action("Posts", "Admin")" class="btn btn-primary">Manage Posts</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Create Post</h5>
                <p class="card-text">Write and publish a new blog post.</p>
                <a href="@Url.Action("CreatePost", "Admin")" class="btn btn-primary">Create New Post</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                <p class="card-text">Manage blog post categories.</p>
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-primary">Manage Categories</a>
            </div>
        </div>
    </div>
</div>
