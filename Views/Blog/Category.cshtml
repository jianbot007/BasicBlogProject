@model IEnumerable<SimpleBlog.Models.Entities.BlogPost>
@using SimpleBlog.Models.Entities

@{
    var category = ViewBag.CurrentCategory as Category;
    ViewData["Title"] = category?.Name ?? "Category";
}

@if (category != null)
{
    <div class="row">
        <div class="col-md-8">
            <h1>@category.Name</h1>
            @if (!string.IsNullOrEmpty(category.Description))
            {
                <p class="lead text-muted">@category.Description</p>
            }

            <hr />

            @if (Model != null )
            {
                @foreach (var post in Model)
                {
                    <div class="card mb-4">
                        @if (!string.IsNullOrEmpty(post.FeaturedImage))
                        {
                            <img src="@post.FeaturedImage" class="card-img-top" alt="@post.Title" style="height: 250px; object-fit: cover;">
                        }
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="@Url.Action("Post", "Blog", new { slug = post.Slug })" class="text-decoration-none">
                                    @post.Title
                                </a>
                            </h5>
                            <p class="card-text">@post.ShortDescription</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">@post.CreatedAt.ToString("MMM dd, yyyy")</small>
                                <a href="@Url.Action("Post", "Blog", new { slug = post.Slug })" class="btn btn-sm btn-primary">Read More</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="alert alert-info">No posts in this category yet.</p>
            }

            <a href="@Url.Action("Index", "Blog")" class="btn btn-secondary">Back to All Posts</a>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>Categories</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Categories != null && ((IEnumerable<Category>)ViewBag.Categories).Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cat in (IEnumerable<Category>)ViewBag.Categories)
                            {
                                <li class="list-group-item @(cat.Id == category.Id ? "active" : "")">
                                    <a href="@Url.Action("Category", "Blog", new { slug = cat.Slug })" class="text-decoration-none">
                                        @cat.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No categories available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="alert alert-danger">Category not found.</p>
}
